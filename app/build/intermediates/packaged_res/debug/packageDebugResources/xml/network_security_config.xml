<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext (HTTP) trafiği tamamen yasaklanır.
        Yalnızca TLS/HTTPS bağlantılarına izin verilir.
        Kullanıcı tarafından yüklenmiş CA sertifikaları GÜVENILMEZ —
        bu sayede kullanıcının cihazına eklenmiş sahte CA ile MITM engellanır.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Yalnızca sistem CA'ları kabul edilir -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
